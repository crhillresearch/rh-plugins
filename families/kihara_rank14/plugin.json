  "id": "kihara2001_rank14",
  "name": "Kihara (2001)",
  "version": "1.2.0",
  "description": "Kihara's published generic-rank-at-least-14 family with exact quartic reconstruction, fourteen exact sections, an independent Rank Hunter generic lower-bound certificate at the paper's t=2 control, and native/PGL2 search.",
  "enabled_by_default": true,
  "curve_family_name": "Kihara 2001, generic rank >=14",
  "minimum_rank_hunter_version": "0.9.2",
  "family": {
    "kind": "module",
    "spec": "kihara2001_rank14",
    "file": "family.py",
    "aliases": [
      "rank42.families.kihara2001_rank14"
    ]
  },
  "search_adapter": "search_adapter.py",
  "capabilities": [
    "candidate_generation",
    "family_search",
    "target_search",
    "known_subgroup",
    "quartic_search",
    "pgl2_search",
    "free_search"
  ],
  "validation_parameter": "1",
  "candidate_defaults": {
    "a_min": -3000,
    "a_max": 3000,
    "b_min": 1,
    "b_max": 250,
    "engine": "sieve",
    "stage_bounds": "200,500",
    "stage_keeps": "3000,300",
    "top": 300
  },
  "provenance": {
    "author": "Shoichi Kihara",
    "paper": "On an elliptic curve over Q(t) of rank >= 14",
    "journal": "Proc. Japan Acad. Ser. A Math. Sci. 77 (2001), 50-51",
    "doi": "10.3792/pjaa.77.50",
    "source_url": "https://doi.org/10.3792/pjaa.77.50",
    "published_claim": "Kihara proves Q(t)-rank at least 14.",
    "theorem_proof_control": "The published proof specializes at t=2 and reports a nonzero determinant of the 14x14 canonical-height pairing matrix, proving P1,...,P14 independent.",
    "published_height_determinant": "221792776617402574.10 (reported numerically in the paper)",
    "reconstruction_status": "The plugin reconstructs Kihara's genus-one quartic, P1..P14, and the P15-origin Weierstrass map exactly.",
    "release_claim_boundary": "Rank Hunter independently exact-certifies P1..P14 at t=2 to verify generic lower bound 14. The paper proves only a lower bound, not exact generic rank; specialization lower bounds still require exact per-fiber certification."
  },
  "historical_generic_rank_lower": 14,
  "verified_generic_rank_lower": 14,
  "generic_rank_claim_state": "generic_lower_bound_verified",
