{
  "schema_version": 1,
  "plugin_type": "family",
  "id": "fibonacci_triples",
  "name": "Fibonacci Triples",
  "version": "0.1.3",
  "description": "Odd/even one-parameter elliptic families induced by Fibonacci Diophantine triples, with Dujella's published exact generic ranks 2 and 1, exact forced sections, and Rank Hunter lower-bound certification.",
  "enabled_by_default": false,
  "default_variant": "odd",
  "capabilities": [
    "candidate_generation",
    "family_search",
    "target_search",
    "known_subgroup",
    "free_search"
  ],
  "search_adapter": "adapter.py",
  "variants": [
    {
      "id": "odd",
      "name": "Odd parity family E-",
      "generic_rank": 2,
      "curve_family_name": "Fibonacci triples - odd parity E-",
      "validation_parameter": "3",
      "candidate_defaults": {
        "a_min": -1000,
        "a_max": 1000,
        "b_min": 1,
        "b_max": 100,
        "stage_bounds": "500,2000",
        "stage_keeps": "5000,500",
        "top": 500,
        "engine": "sieve"
      },
      "family": {
        "kind": "module",
        "spec": "fibonacci_triples_odd",
        "file": "odd_family.py",
        "aliases": [
          "fib-odd",
          "fibonacci-odd"
        ]
      },
      "historical_generic_rank_lower": 2,
      "verified_generic_rank_lower": 2,
      "generic_rank_claim_state": "generic_lower_bound_verified",
      "provenance": {
        "published_exact_generic_rank": 2,
        "operational_verified_generic_lower": 2,
        "validation_control": "T=3 for Rank Hunter lower-bound certificate",
        "paper_injectivity_control": "T=85/38 (k=17)"
      }
    },
    {
      "id": "even",
      "name": "Even parity family E+",
      "generic_rank": 1,
      "curve_family_name": "Fibonacci triples - even parity E+",
      "validation_parameter": "20/9",
      "candidate_defaults": {
        "a_min": -1000,
        "a_max": 1000,
        "b_min": 1,
        "b_max": 100,
        "stage_bounds": "500,2000",
        "stage_keeps": "5000,500",
        "top": 500,
        "engine": "sieve"
      },
      "family": {
        "kind": "module",
        "spec": "fibonacci_triples_even",
        "file": "even_family.py",
        "aliases": [
          "fib-even",
          "fibonacci-even"
        ]
      },
      "historical_generic_rank_lower": 1,
      "verified_generic_rank_lower": 1,
      "generic_rank_claim_state": "generic_lower_bound_verified",
      "provenance": {
        "published_exact_generic_rank": 1,
        "operational_verified_generic_lower": 1,
        "validation_control": "T=20/9",
        "paper_injectivity_control": "T=20/9 (k=12)"
      }
    }
  ],
  "provenance": {
    "paper": "Andrej Dujella, Ranks and integer points on elliptic curves induced by Fibonacci triples",
    "arxiv": "2609.01789v1",
    "source_url": "https://arxiv.org/abs/2609.01789",
    "doi": "10.48550/arXiv.2609.01789",
    "submitted": "2026-09-01",
    "theorem_reference": "Theorem 5.1; Proposition 3.3; equations (14) and (15)",
    "published_generic_ranks": "Theorem 5.1 proves generic Mordell-Weil rank 2 for the odd family E- and rank 1 for the even family E+.",
    "odd_independence": "Proposition 3.3 proves P_k and Q_k independent for every odd k >= 3.",
    "release_claim_boundary": "Rank Hunter operationally verifies only the generic lower bounds contributed by the explicit sections using exact specialization certificates. The published exact generic upper bounds remain literature provenance and are not re-proved by the plugin validator.",
    "controls": "Odd control T=85/38 corresponds to k=17; even control T=20/9 corresponds to k=12 in the paper's injective-specialization proof."
  },
