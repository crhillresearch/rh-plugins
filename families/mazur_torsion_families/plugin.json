{
  "schema_version": 1,
  "plugin_type": "family",
  "id": "mazur_torsion_families",
  "name": "Mazur Torsion Families",
  "version": "0.1.5",
  "icon": ":material/hub:",
  "description": "Direct prescribed-torsion search families covering all 15 rational torsion groups allowed by Mazur over Q. Kubert-Tate modular families are used where this package carries a one-parameter universal model; low-level 2/3-torsion cases remain explicitly labeled direct slices. Rank Hunter exact-checks specialized torsion before any record-hunt result counts.",
  "enabled_by_default": true,
  "default_variant": "c2xc8",
  "capabilities": [
    "candidate_generation"
  ],
  "variants": [
    {
      "id": "trivial",
      "name": "Trivial direct torsion slice",
      "curve_family_name": "Mazur torsion Trivial direct torsion slice",
      "torsion_groups": [
        "Trivial"
      ],
      "torsion_provider_role": "prescribed_subfamily",
      "validation_parameter": "2",
      "torsion_record": {
        "rank_lower": 31,
        "goal_rank": 32,
        "source": {
          "name": "Andrej Dujella, High rank elliptic curves with prescribed torsion",
          "url": "https://web.math.pmf.unizg.hr/~duje/tors/tors.html",
          "as_of": "2026-10-02"
        },
        "secondary_family_search_recommended": false
      },
      "candidate_defaults": {
        "a_min": -3000,
        "a_max": 3000,
        "b_min": 1,
        "b_max": 300,
        "stage_bounds": "500,1000,2000",
        "stage_keeps": "12000,2500,500",
        "top": 500,
        "engine": "sieve"
      },
      "auto_search": {
        "target_rank": 32,
        "pool_size": 180,
        "deep_keep": 36,
        "upper_timeout": 8,
        "final_upper_timeout": 30,
        "exact_candidates": 64,
        "strategy_note": "Direct prescribed-torsion record hunt: exact torsion match before rank promotion."
      },
      "family": {
